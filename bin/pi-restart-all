#!/usr/bin/env bash
# pi-restart-all: restart every pi running in tmux and resume each where it was.
#
# Each pi with the restart extension (extensions/restart) keeps a record in
# ~/.local/state/pi-restart/live/<pid>.json: session file, cwd, tmux pane and socket, whether the
# approval guardian is bypassed. For each one, in parallel:
#   1. SIGUSR2: pi shuts down once it is idle (a running turn finishes first).
#   2. In the same pane: `pi --session <file>` (typed into the pane's shell, or the pane is
#      respawned with "$SHELL -ic 'pi --session <file>; exec $SHELL -i'" when it died with pi).
#      --session FILE and --cd DIR (with --only) resume FILE instead and type
#      `cd -- DIR && pi --session FILE`; a respawned pane's shell starts in DIR too.
#   3. If the guardian was bypassed when pi left: types `/approval-guardian bypass` into the new
#      pi once it is up and idle in that pane.
# A record counts only when it is a regular file of ours named <pid>.json and that pid is a "pi"
# process on the pane's tty. Sessions without the extension are listed: /reload them once.
# --reload-old types /reload into those that agent-link shows idle (~/.claude/sessions/<pid>.json);
# text left unsent in such a pane's editor would be sent along with it.
#
# Usage: pi-restart-all [--dry-run] [--foreground] [--wait SECONDS] [--only PANE]
#                      [--session FILE] [--cd DIR] [--reload-old]
#   Runs detached by default (it may restart the pi that started it); the log is
#   ~/.local/state/pi-restart/last.log.
set -u

state="${XDG_STATE_HOME:-$HOME/.local/state}/pi-restart"
live="$state/live"
log="$state/last.log"
dry=0 fg=0 wait_s=900 only="" reload_old=0 session_opt="" cd_opt=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry=1 ;;
    --foreground) fg=1 ;;
    --reload-old) reload_old=1 ;;
    --wait) wait_s="${2:?--wait needs seconds}"; shift ;;
    --only) only="${2:?--only needs a pane id like %12}"; shift ;;
    --session) session_opt="${2:?--session needs a session file}"; shift ;;
    --cd) cd_opt="${2:?--cd needs a directory}"; shift ;;
    -h|--help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "pi-restart-all: unknown option $1" >&2; exit 2 ;;
  esac
  shift
done
case "$wait_s" in ''|*[!0-9]*) echo "pi-restart-all: --wait takes whole seconds" >&2; exit 2 ;; esac
case "$only" in '') ;; %*) case "${only#%}" in ''|*[!0-9]*) echo "pi-restart-all: --only takes a pane id like %12" >&2; exit 2 ;; esac ;; *) echo "pi-restart-all: --only takes a pane id like %12" >&2; exit 2 ;; esac
if [ -n "$session_opt" ] || [ -n "$cd_opt" ]; then
  [ -n "$only" ] || { echo "pi-restart-all: --session and --cd need --only" >&2; exit 2; }
fi
if [ -n "$cd_opt" ] && [ -z "$session_opt" ]; then
  # pi takes its cwd from the session file's header, so --cd alone would resume in the old directory.
  echo "pi-restart-all: --cd needs --session (a session whose header names that directory)" >&2; exit 2
fi
for v in "$session_opt" "$cd_opt"; do
  case "$v" in *[[:cntrl:]]*) echo "pi-restart-all: --session and --cd can't contain control characters" >&2; exit 2 ;; esac
done
if [ -n "$session_opt" ] && { [ ! -e "$session_opt" ] || [ ! -f "$session_opt" ]; }; then
  echo "pi-restart-all: --session is not a regular file: $session_opt" >&2; exit 2
fi
if [ -n "$cd_opt" ]; then
  [ -d "$cd_opt" ] || { echo "pi-restart-all: --cd is not a directory: $cd_opt" >&2; exit 2; }
  cd_opt=$(cd -- "$cd_opt" && pwd -P) || { echo "pi-restart-all: --cd is not a directory: $cd_opt" >&2; exit 2; }
fi

mkdir -p "$state" && chmod 700 "$state"
self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

if [ "$dry" = 0 ] && [ "$fg" = 0 ]; then
  args=(--foreground --wait "$wait_s")
  [ -n "$only" ] && args+=(--only "$only")
  [ -n "$session_opt" ] && args+=(--session "$session_opt")
  [ -n "$cd_opt" ] && args+=(--cd "$cd_opt")
  [ "$reload_old" = 1 ] && args+=(--reload-old)
  # Under the tmux server when there is one: outlives the pi (and its tool) that started it.
  # The tmux server's environment isn't ours: pass the bits the run depends on.
  cmd="env $(printf '%q ' "PATH=$PATH" "SHELL=${SHELL:-/bin/zsh}" "XDG_STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}" "$self" "${args[@]}") >$(printf '%q' "$log") 2>&1 </dev/null"
  if tmux run-shell -b "$cmd" 2>/dev/null; then
    echo "pi-restart-all: restarting in the background (tmux run-shell); log: $log"
  else
    nohup "$self" "${args[@]}" >"$log" 2>&1 </dev/null &
    echo "pi-restart-all: restarting in the background (pid $!); log: $log"
  fi
  exit 0
fi

command -v jq >/dev/null || { echo "pi-restart-all: needs jq" >&2; exit 1; }
say() { printf '%s %s\n' "$(date +%H:%M:%S)" "$*"; }
field() { jq -r --arg k "$2" '.[$k] // empty' "$1" 2>/dev/null; }
alive() { kill -0 "$1" 2>/dev/null; }

# A record file we can trust as far as files go: ours, regular (no symlink), named <pid>.json for
# the pid inside, with a pane id and a socket path that are just that.
sane_record() {
  local f="$1" pid pane socket
  [ -f "$f" ] && [ ! -L "$f" ] && [ -O "$f" ] || return 1
  pid=$(field "$f" pid); pane=$(field "$f" pane); socket=$(field "$f" socket)
  case "$pid" in ''|*[!0-9]*) return 1 ;; esac
  [ "$(basename "$f")" = "$pid.json" ] || return 1
  case "$pane" in %*) case "${pane#%}" in ''|*[!0-9]*) return 1 ;; esac ;; *) return 1 ;; esac
  case "$socket" in /*) ;; *) return 1 ;; esac
  [ -S "$socket" ]
}

# Whether pid is a running pi in that pane: process title "pi", on the pane's tty.
pi_in_pane() {
  local socket="$1" pane="$2" pid="$3" tty args
  tty=$(tmux -S "$socket" display-message -p -t "$pane" '#{pane_tty}' 2>/dev/null) || return 1
  args=$(ps -o args= -p "$pid" 2>/dev/null | sed 's/[[:space:]]*$//') || return 1 # pi pads its title
  [ "$args" = "pi" ] || return 1
  [ "/dev/$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')" = "$tty" ]
}

# Waits for the new pi's record in this pane (another pid, the same session file when given),
# verified as above; prints its path.
new_record() {
  local socket="$1" pane="$2" session="$3" old_pid="$4" deadline=$((SECONDS + 90)) f pid
  while [ $SECONDS -lt $deadline ]; do
    for f in "$live"/*.json; do
      sane_record "$f" || continue
      pid=$(field "$f" pid)
      [ "$pid" != "$old_pid" ] && [ "$(field "$f" pane)" = "$pane" ] && [ "$(field "$f" exiting)" != true ] || continue
      [ -z "$session" ] || [ "$(field "$f" sessionFile)" = "$session" ] || continue
      pi_in_pane "$socket" "$pane" "$pid" && { echo "$f"; return 0; }
    done
    sleep 1
  done
  return 1
}

record_bypassed() { [ "$(field "$1" bypass)" = true ]; }

# The command typed into the pane (or run by the respawned shell): a session to resume, and a
# directory to cd to first when --cd was given.
resume_command() {
  local session="$1" resume="$2" dir="$3" cmd
  if [ "$resume" = 1 ]; then cmd="pi --session $(printf '%q' "$session")"; else cmd="pi"; fi
  [ -n "$dir" ] && cmd="cd -- $(printf '%q' "$dir") && $cmd"
  printf '%s' "$cmd"
}
editor_cleared() { ! tmux -S "$1" capture-pane -p -t "$2" | grep -v "^[[:space:]]*$" | tail -n 3 | grep -qF -- "$3"; }

# Types a slash command into the pane and presses Enter until the check (a function and its
# arguments) passes: the first Enter can go to the command's autocomplete. Ctrl+E Ctrl+U first
# empties the editor line: the guardian has already put `/approval-guardian bypass` there in a
# resumed session that ended bypassed.
type_command() {
  local socket="$1" pane="$2" text="$3"; shift 3
  tmux -S "$socket" send-keys -t "$pane" C-e C-u
  tmux -S "$socket" send-keys -t "$pane" -l "$text"
  for _ in 1 2 3; do
    sleep 1
    tmux -S "$socket" send-keys -t "$pane" Enter
    sleep 2
    "$@" && return 0
  done
  return 1
}

# A shell started with -c never reaches an idle prompt, so the fnox hook that loads the
# keychain's secrets into the environment (COPILOT_TOKEN, which pi's github-copilot provider reads)
# never runs there: load them first, or pi comes back without its Copilot models.
with_secrets() { printf '%s' "command -v fnox >/dev/null && eval \"\$(fnox hook-env -s zsh --if-missing ignore 2>/dev/null)\"; $1"; }

# The pane's tmux session and window name, read before pi leaves: the pane may close with it.
pane_place() { tmux -S "$1" display-message -p -t "$2" '#{session_name}	#{window_name}' 2>/dev/null; }

# A new window (or the tmux session again, when it closed with its last pane) running pi inside a
# login shell, so the window outlives pi; prints its pane id.
new_window() {
  local socket="$1" tsession="$2" wname="$3" dir="$4" cmd="$5" sh="${SHELL:-/bin/zsh}" run
  run="$(printf '%q' "$sh") -ic $(printf '%q' "$(with_secrets "$cmd"); exec $(printf '%q' "$sh") -i")"
  [ -d "$dir" ] || dir="$HOME"
  tmux -S "$socket" new-window -d -P -F '#{pane_id}' -t "$tsession:" -n "$wname" -c "$dir" "$run" 2>/dev/null ||
    tmux -S "$socket" new-session -d -P -F '#{pane_id}' -s "$tsession" -n "$wname" -c "$dir" "$run" 2>/dev/null ||
    tmux -S "$socket" new-window -d -P -F '#{pane_id}' -t "$tsession:" -n "$wname" -c "$dir" "$run" # lost a race to recreate it
}

# Whether the pane shows a plain shell, waiting up to 5s: the shell's prompt hooks can run a
# moment after pi exits.
shell_in_pane() {
  local deadline=$((SECONDS + 5))
  while :; do
    case "$(tmux -S "$1" display-message -p -t "$2" '#{pane_current_command}' 2>/dev/null)" in
      zsh|bash|sh|-zsh|-bash|login) return 0 ;;
    esac
    [ $SECONDS -lt $deadline ] || return 1
    sleep 0.5
  done
}

restart_one() {
  local rec="$1" pid pane socket session cwd name
  pid=$(field "$rec" pid); pane=$(field "$rec" pane); socket=$(field "$rec" socket)
  session=$(field "$rec" sessionFile); cwd=$(field "$rec" cwd)
  [ -n "$session_opt" ] && session="$session_opt"
  [ -n "$cd_opt" ] && cwd="$cd_opt"
  name="$pane ($(basename "$cwd"))"
  # pi writes the session file with the first reply: before that there's nothing to resume, so a
  # fresh pi starts in the pane instead.
  local resume=1
  [ -f "$session" ] || resume=0
  if [ "$dry" = 1 ]; then
    say "$name: would restart pid $pid, $([ $resume = 1 ] && echo "resume $(basename "$session")" || echo "fresh pi (nothing to resume)")$([ "$(field "$rec" bypass)" = true ] && echo ', bypass'); would type: $(resume_command "$session" "$resume" "$cd_opt")"
    return
  fi

  pi_in_pane "$socket" "$pane" "$pid" || { say "$name: pid $pid is no longer that pane's pi"; return; }
  local place tsession wname
  place=$(pane_place "$socket" "$pane"); tsession=${place%%$'\t'*}; wname=${place#*$'\t'}
  [ -n "$tsession" ] || tsession=pi
  [ -n "$wname" ] && [ "$wname" != node ] && [ "$wname" != pi ] || wname=$(basename "$cwd")
  say "$name: asking pid $pid to stop when idle"
  kill -USR2 "$pid" 2>/dev/null || { say "$name: pid $pid is gone"; return; }
  local deadline=$((SECONDS + wait_s))
  while alive "$pid" && [ $SECONDS -lt $deadline ]; do sleep 1; done
  if alive "$pid"; then say "$name: still busy after ${wait_s}s, left running"; return; fi
  sleep 0.5
  # Bypass as pi left (its session_shutdown wrote it last), not as it was when we started.
  local bypass=false
  if sane_record "$rec" && [ "$(field "$rec" exiting)" = true ]; then
    bypass=$(field "$rec" bypass)
    # A /new or /resume between the signal and the exit: resume the session it left from, unless
    # --session/--cd named where to continue.
    [ -n "$session_opt" ] || session=$(field "$rec" sessionFile)
    [ -n "$cd_opt" ] || cwd=$(field "$rec" cwd)
    resume=1; [ -f "$session" ] || resume=0
  fi
  rm -f "$rec"

  local sh="${SHELL:-/bin/zsh}" pi_cmd
  pi_cmd=$(resume_command "$session" "$resume" "$cd_opt")
  # A pane that closed with pi, or runs something else now: pi goes into a new window instead.
  # A dead pane (remain-on-exit) is respawned; a pane back at its shell gets the command typed.
  local how
  if ! tmux -S "$socket" display-message -p -t "$pane" '#{pane_id}' >/dev/null 2>&1; then
    how="the pane closed with pi"
  elif [ "$(tmux -S "$socket" display-message -p -t "$pane" '#{pane_dead}')" = 1 ]; then
    how="respawn"
  elif shell_in_pane "$socket" "$pane"; then
    how="type"
  else
    how="the pane runs $(tmux -S "$socket" display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null) now"
  fi
  case "$how" in
    respawn)
      tmux -S "$socket" respawn-pane -k -t "$pane" -c "$cwd" "$(printf '%q' "$sh") -ic $(printf '%q' "$(with_secrets "$pi_cmd"); exec $(printf '%q' "$sh") -i")" ;;
    type)
      if ! tmux -S "$socket" send-keys -t "$pane" -l "$pi_cmd" || ! tmux -S "$socket" send-keys -t "$pane" Enter; then
        say "$name: couldn't type the command, not resumed ($pi_cmd)"; return
      fi ;;
    *)
      local new_pane
      if ! new_pane=$(new_window "$socket" "$tsession" "$wname" "$cwd" "$pi_cmd"); then
        say "$name: $how, and no new window would open: not resumed ($pi_cmd)"; return
      fi
      say "$name: $how: resuming in a new window $tsession:$wname ($new_pane)"
      pane="$new_pane"; name="$pane ($(basename "$cwd"))" ;;
  esac

  local fresh
  if ! fresh=$(new_record "$socket" "$pane" "$([ $resume = 1 ] && echo "$session")" "$pid"); then
    say "$name: pi didn't come back within 90s (check the pane)"
    return
  fi
  local new_pid; new_pid=$(field "$fresh" pid)
  if [ "$bypass" != true ]; then say "$name: resumed as pid $new_pid"; return; fi
  sleep 2 # let the editor take keys
  if [ "$(field "$fresh" idle)" = true ] && pi_in_pane "$socket" "$pane" "$new_pid" &&
     type_command "$socket" "$pane" "/approval-guardian bypass" record_bypassed "$fresh"; then
    say "$name: resumed as pid $new_pid, guardian bypass restored"
  else
    say "$name: resumed as pid $new_pid, but the bypass didn't come back: run /approval-guardian bypass"
  fi
}

# One record per pane: the verified, live one.
records=() panes=" "
for f in "$live"/*.json; do
  [ -e "$f" ] || continue
  if ! sane_record "$f"; then [ -f "$f" ] && [ ! -L "$f" ] && [ -O "$f" ] && ! alive "$(field "$f" pid)" && rm -f "$f"; continue; fi
  pid=$(field "$f" pid); pane=$(field "$f" pane)
  if ! alive "$pid"; then rm -f "$f"; continue; fi
  [ "$(field "$f" exiting)" = true ] && continue # already on its way out
  [ -n "$only" ] && [ "$pane" != "$only" ] && continue
  case "$panes" in *" $pane "*) say "$pane: more than one record, skipped"; continue ;; esac
  pi_in_pane "$(field "$f" socket)" "$pane" "$pid" || continue
  panes+="$pane "
  records+=("$f")
done

# pi processes in tmux panes that have no record (no restart extension yet).
if [ -z "$only" ] && command -v tmux >/dev/null; then
  # pi sets its process title to "pi": a pane's shell with a child "pi" runs pi.
  pis=$(ps -ax -o pid=,ppid=,args= | awk '$3 == "pi" && NF == 3 { print $1, $2 }')
  sock=$(tmux display-message -p '#{socket_path}' 2>/dev/null)
  while read -r pane ppid target; do
    case "$panes" in *" $pane "*) continue ;; esac
    pi_pid=$(awk -v p="$ppid" '$2 == p { print $1; exit }' <<<"$pis")
    [ -n "$pi_pid" ] || continue
    if [ "$reload_old" = 1 ] && [ "$dry" = 0 ]; then
      status=$(jq -r '.status // empty' "$HOME/.claude/sessions/$pi_pid.json" 2>/dev/null)
      if [ "$status" = idle ]; then
        type_command "$sock" "$pane" "/reload" editor_cleared "$sock" "$pane" "/reload" >/dev/null
        say "$target ($pane): no restart extension yet: sent /reload (rerun pi-restart-all after)"
      else
        say "$target ($pane): no restart extension yet, and not idle (${status:-unknown}): /reload it yourself"
      fi
    else
      say "$target ($pane): pi without the restart extension: /reload it once (or --reload-old), then rerun"
    fi
  done < <(tmux list-panes -a -F '#{pane_id} #{pane_pid} #{session_name}:#{window_name}' 2>/dev/null)
fi

[ ${#records[@]} -eq 0 ] && { say "no restartable pi sessions"; exit 0; }
say "restarting ${#records[@]} pi session(s)$([ "$dry" = 1 ] && echo ' (dry run)')"
for f in "${records[@]}"; do restart_one "$f" & done
wait
say "done"
